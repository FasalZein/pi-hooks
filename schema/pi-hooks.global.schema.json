{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tothemoon.dev/schemas/pi-hooks/global-v2.json",
  "title": "Pi Hooks trusted global configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "description": "1 is accepted and migrated in-memory to 2; the on-disk file is never rewritten.",
      "enum": [
        1,
        2
      ]
    },
    "modules": {
      "description": "events-grant shorthand: Hook Modules on the nine-event contract.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "providers": {
      "description": "Capability Providers authorized by trusted global configuration.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "config": {
            "description": "Validated against the provider manifest configSchema."
          }
        }
      }
    },
    "rendering": {
      "description": "Render Hooks TUI without changing decisions. False selects plain status and Pi confirmation dialogs.",
      "type": "boolean",
      "default": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "includeAllows": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "rules": {
      "description": "Named overrides to Preset Policy Rules; enabled false disables an id.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "recipes": {
      "description": "Named Recipe entries, validated by Action Engine.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "lsp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "enablement": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diagnosticsMs": {
              "type": "integer",
              "minimum": 1
            },
            "initializeMs": {
              "type": "integer",
              "minimum": 1
            },
            "requestMs": {
              "type": "integer",
              "minimum": 1
            },
            "shutdownMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
