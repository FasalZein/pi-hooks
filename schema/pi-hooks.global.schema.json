{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tothemoon.dev/schemas/pi-hooks/global-v2.json",
  "title": "Pi Hooks trusted global configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "description": "1 is accepted and migrated in-memory to 2; the on-disk file is never rewritten.",
      "enum": [1, 2]
    },
    "modules": {
      "description": "events-grant shorthand: Hook Modules on the nine-event contract.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean", "default": true },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "providers": {
      "description": "Capability Providers authorized by trusted global configuration.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean", "default": true },
          "required": { "type": "boolean", "default": true },
          "config": { "description": "Validated against the provider manifest configSchema." }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "includeAllows": { "type": "boolean", "default": false }
      }
    }
  }
}
