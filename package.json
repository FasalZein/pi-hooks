{
  "name": "@tothemoon/pi-hooks",
  "version": "0.1.0",
  "description": "Extension-only deterministic Hook Host for Pi 0.80.7.",
  "type": "module",
  "license": "MIT",
  "files": ["src", "schema", "README.md"],
