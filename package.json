{
  "name": "@tothemoon/pi-hooks",
  "version": "0.1.0",
  "description": "Extension-only deterministic Hook Host for Pi 0.85.1.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "schema",
    "README.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "hooks"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "verify": "npm run typecheck && npm run lint && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.12.0",
    "eslint": "10.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.0.18"
  }
}
